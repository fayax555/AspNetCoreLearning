@model TodoItem

@{
    ViewData["Title"] = "Todo Details";

    var currentDate = DateOnly.FromDateTime(DateTime.Today);
}

<h1>@ViewData["Title"]</h1>

<a asp-controller="Todos" asp-action="Index">Go to Todos</a>

<ul>
    <li>ID: @Model.Id</li>
    <li>Title: @Model.Title</li>
    <li>Status: @(Model.IsCompleted ? "Completed": "Incomplete")</li>
    <li>Priority: @Model.Priority</li>
    <li>Due date: @(Model.DueDate?.ToString("yyyy-MM-dd") ?? "None")</li>
    <li>Category: @(Model.Category?.Name ?? "None")</li>

    @if (Model.IsOverdue(currentDate))
    {
        <li><strong>Overdue</strong></li>
    }
</ul>
