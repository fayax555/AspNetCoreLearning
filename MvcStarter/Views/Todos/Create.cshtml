@model CreateTodoInputModel

@{
    ViewData["Title"] = "Create Todo";
}

<h1>@ViewData["Title"]</h1>

<form method="post" asp-controller="Todos" asp-action="Create">
    <label asp-for="Title">Title</label>
    <input asp-for="Title" />
    <span asp-validation-for="Title"></span>

    <label asp-for="Priority"></label>

    <select asp-for="Priority" asp-items="Html.GetEnumSelectList<TodoPriority>()">
        <option value="">Choose a priority</option>
    </select>

    <span asp-validation-for="Priority"></span>

    <label asp-for="DueDate"></label>
    <input asp-for="DueDate" />
    <span asp-validation-for="DueDate"></span>

    <label asp-for="CategoryId">Category</label>

    <select asp-for="CategoryId">
        <option value="">No category</option>

        @foreach (var category in Model.Categories)
        {
            <option value="@category.Id">@category.Name</option>
        }
    </select>

    <span asp-validation-for="CategoryId"></span>

    <button type="submit">Submit</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}