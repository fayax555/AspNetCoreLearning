@model TodoIndexViewModel

@{
    ViewData["Title"] = "Todos";
}

@if (TempData["SuccessMessage"] is string message)
{
    <p>@message</p>
}

<h1>Your Todo List</h1>

<form method="get" asp-action="Index">
    <input name="search" value="@Model.Search" />

    <select asp-for="SelectedPriority" asp-items="Html.GetEnumSelectList<TodoPriority>()">
        <option value="">All priorities</option>
    </select>

    <button type="submit">Search</button>
</form>

<a asp-action="Create">Create Todo</a>

@if (Model.Todos.Count == 0)
{
    <p>No matching todos.</p>
}

<ul>
    @foreach(var todo in Model.Todos)
    {
        <li>[@(todo.IsCompleted ? "x" : " ")] @todo.Title - Priority: @todo.Priority - Category:@(todo.Category?.Name ?? "None")

            @if (!todo.IsCompleted)
            {
                <form method="post" asp-action="Complete" asp-route-id="@todo.Id">
                    <button type="submit" >Complete</button>
                </form>
            }

            <form method="post" asp-action="Delete" asp-route-id="@todo.Id">
                <button type="submit">Delete</button>
            </form>

            <a asp-action="Details" asp-route-id="@todo.Id">Details</a>
            <a asp-action="Edit" asp-route-id="@todo.Id">Edit</a>
        </li>
    }
</ul>

@if (Model.TotalPages > 1)
{
    <nav>
        @if (Model.CurrentPage > 1)
        {
            <a asp-action="Index"
                asp-route-search="@Model.Search"
                asp-route-selectedPriority="@Model.SelectedPriority" 
                asp-route-page="@(Model.CurrentPage - 1)">
                Previous
            </a>
        }

        <span>Page @Model.CurrentPage of @Model.TotalPages</span>

        @if (Model.CurrentPage < Model.TotalPages)
        {
            <a asp-action="Index" 
                asp-route-search="@Model.Search" 
                asp-route-selectedPriority="@Model.SelectedPriority" 
                asp-route-page="@(Model.CurrentPage + 1)">Next
            </a>
        }
    </nav>
}