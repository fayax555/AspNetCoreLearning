@model IReadOnlyList<Category>

@{
    ViewData["Title"] = "Categories";
}

<h1>Categories</h1>

@if (TempData["Success"] is string message)
{
    <p>@message</p>
}

<a asp-action="Create">Create Category</a>

@if (Model.Count == 0)
{
    <p>There are no categories.</p>
}
else
{
    <ul>
        @foreach (var category in Model)
        {
            <li>
                @category.Name
                <a asp-action="Details" asp-route-id="@category.Id">Details</a>
                <a asp-action="Edit" asp-route-id="@category.Id">Edit</a>
                <a asp-action="Delete" asp-route-id="@category.Id">Delete</a>
            </li>
        }
    </ul>
}