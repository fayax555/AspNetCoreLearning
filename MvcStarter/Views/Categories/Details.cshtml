@model CategoryDetailsViewModel

@{
    ViewData["Title"] = "Category details";

    var currentDate = DateOnly.FromDateTime(DateTime.Today);
}

<a asp-action="Index">Back to categories</a>

<h1>@Model.Category.Name</h1>

@if (Model.Todos.Count == 0)
{
    <p>There are no tasks in this category.</p>
}
else
{
    <ul>
        @foreach (var todo in Model.Todos)
        {
            <li>@todo.Title - @todo.Priority - @todo.IsCompleted - Due date: @(todo.DueDate?.ToString("yyyy-MM-dd") ?? "None")
                @if (todo.IsOverdue(currentDate))
                {
                    <strong>- Overdue</strong>
                }
            </li>
        }
    </ul>
}