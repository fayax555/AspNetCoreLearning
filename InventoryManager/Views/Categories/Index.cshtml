@model IReadOnlyList<Category>

@{
    ViewData["Title"] = "Categories";
}

<h1>Categories</h1>

<a asp-action="Create">Create Category</a>

@if (Model.Count == 0)
{
    <p>There are no categories.</p>
}
else
{
    <ul>
        @foreach (var category in Model)
        {
            <li>@category.Name</li>
        }
    </ul>
}
