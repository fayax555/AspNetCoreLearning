@model IReadOnlyList<Category>

@{
    ViewData["Title"] = "Categories";
}

<h1>Categories</h1>

@if (TempData["Success"] is string successMessage)
{
    <p>@successMessage</p>
}

@if(TempData["Error"] is string errorMessage)
{
    <p>@errorMessage</p>
}

<a asp-action="Create">Create Category</a>

@if (Model.Count == 0)
{
    <p>There are no categories.</p>
}
else
{
    <ul>
        @foreach (var category in Model)
        {
            <li>
                @category.Name -
                <a asp-action="Edit" asp-route-id="@category.Id">Edit</a>
                <form method="post" asp-action="Delete" asp-route-id="@category.Id">
                    <button type="submit">Delete</button>
                </form>
            </li>
        }
    </ul>
}
