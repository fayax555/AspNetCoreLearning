<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - InventoryManager</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="flex min-h-screen flex-col bg-slate-50 text-slate-900">
    <header class="border-b border-slate-200 bg-white shadow-sm">
        <nav class="mx-auto flex w-full max-w-6xl items-center justify-between px-6 py-4">
            <a class="text-xl font-semibold text-slate-900" asp-area="" asp-controller="Home" asp-action="Index">InventoryManager</a>
            <ul class="flex items-center gap-6">
                <li>
                    <a class="text-sm font-medium text-slate-600 hover:text-blue-600" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                </li>
                <li>
                    <a class="text-sm font-medium text-slate-600 hover:text-blue-600" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                </li>
                <li>
                    <a class="text-sm font-medium text-slate-600 hover:text-blue-600" asp-area="" asp-controller="Products" asp-action="Index">Products</a>
                </li>
            </ul>
        </nav>
    </header>

    <div class="mx-auto w-full max-w-6xl flex-1 px-6 py-8">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-t border-slate-200 bg-white">
        <div class="mx-auto w-full max-w-6xl px-6 py-4 text-sm text-slate-500">
            &copy; 2026 - InventoryManager -
            <a class="hover:text-blue-600" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
