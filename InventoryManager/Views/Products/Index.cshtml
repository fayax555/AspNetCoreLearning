@model ProductIndexViewModel

@{
    ViewData["Title"] = "Products";
}

<h1 class="text-3xl font-bold text-blue-600">Products</h1>

@if (TempData["Success"] is string successMessage)
{
    <p>@successMessage</p>
}

<form method="get" asp-action="Index">
    <label asp-for="Search">Search</label>
    <input class="border-2 border-slate-200" asp-for="Search" />
    <button type="submit">Search</button>
    <a asp-action="Index">Clear</a>
</form>

<a asp-action="Create">Create product</a>

@if (Model.Products.Count == 0)
{
    <p>There are no products.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>SKU</th>
                <th>Category</th>
                <th>Quantity in stock</th>
                <th>Reorder level</th>
                <th>Unit price</th>
                <th>Discontinued status</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var product in Model.Products)
            {
                <tr>
                    <td>@product.Name</td>
                    <td>@product.Sku</td>
                    <td>@product.Category?.Name</td>
                    <td>@product.QuantityInStock</td>
                    <td>@product.ReorderLevel</td>
                    <td>@product.UnitPrice</td>
                    <td>@product.IsDiscontinued</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@product.Id">Edit</a>
                        <form method="post" asp-action="Delete" asp-route-id="@product.Id">
                            <button>Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}