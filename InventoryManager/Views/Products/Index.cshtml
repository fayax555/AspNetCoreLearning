@model IReadOnlyList<Product>

@{
    ViewData["Title"] = "Products";
}

<h1>Products</h1>

@if (TempData["Success"] is string successMessage)
{
    <p>@successMessage</p>
}

<a asp-action="Create">Create product</a>

@if (Model.Count == 0)
{
    <p>There are no products.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>SKU</th>
                <th>Category</th>
                <th>Quantity in stock</th>
                <th>Reorder level</th>
                <th>Unit price</th>
                <th>Discontinued status</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.Name</td>
                    <td>@product.Sku</td>
                    <td>@product.Category?.Name</td>
                    <td>@product.QuantityInStock</td>
                    <td>@product.ReorderLevel</td>
                    <td>@product.UnitPrice</td>
                    <td>@product.IsDiscontinued</td>
                </tr>
            }
        </tbody>
    </table>
}